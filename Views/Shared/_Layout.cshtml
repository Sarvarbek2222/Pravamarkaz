@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string name) => controller == name ? "active" : "";
    var roleText = Me.IsOwner ? "Egasi" : "Markaz menejeri";
}
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Prava Markaz</title>
    <script>
        // Mavzuni sahifa chizilishidan oldin qo'llash (miltillamasligi uchun)
        (function () {
            var t = null;
            try { t = localStorage.getItem('pm-theme'); } catch (e) { }
            if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            document.documentElement.setAttribute('data-bs-theme', t);
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <div class="app">
        <aside class="sidebar" id="sidebar">
            <a class="sidebar-brand" asp-controller="Home" asp-action="Index">
                <span class="brand-logo"><i class="bi bi-car-front-fill"></i></span>
                <span>
                    <span class="brand-name d-block">Prava Markaz</span>
                    <span class="brand-sub">Boshqaruv tizimi</span>
                </span>
            </a>

            <nav class="sidebar-nav">
                <div class="nav-section">Asosiy</div>
                <a class="sidebar-link @Active("Home")" asp-controller="Home" asp-action="Index"><i class="bi bi-grid-1x2"></i> Boshqaruv paneli</a>
                <a class="sidebar-link @Active("Centers")" asp-controller="Centers" asp-action="Index"><i class="bi bi-buildings"></i> @(Me.IsOwner ? "Markazlar" : "Mening markazim")</a>
                <a class="sidebar-link @Active("Students")" asp-controller="Students" asp-action="Index"><i class="bi bi-people"></i> O'quvchilar</a>
                <a class="sidebar-link @Active("Payments")" asp-controller="Payments" asp-action="Index"><i class="bi bi-wallet2"></i> To'lovlar (kassa)</a>

                @if (Me.IsOwner)
                {
                    <div class="nav-section">Tizim</div>
                    <a class="sidebar-link @Active("Users")" asp-controller="Users" asp-action="Index"><i class="bi bi-person-badge"></i> Foydalanuvchilar</a>
                    <a class="sidebar-link @Active("Audit")" asp-controller="Audit" asp-action="Index"><i class="bi bi-clock-history"></i> Amallar tarixi</a>
                }
            </nav>

            <div class="sidebar-user">
                <span class="avatar avatar-sm avatar-round">@Fmt.Initials(Me.FullName, null)</span>
                <div class="flex-grow-1 min-w-0">
                    <div class="name text-truncate">@Me.FullName</div>
                    <div class="role">@roleText</div>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-sm text-secondary p-1" title="Chiqish"><i class="bi bi-box-arrow-right fs-5"></i></button>
                </form>
            </div>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <div class="main">
            <header class="topbar">
                <button class="icon-btn d-lg-none" type="button" id="sidebarToggle" aria-label="Menyu"><i class="bi bi-list fs-5"></i></button>
                <form class="topbar-search" method="get" asp-controller="Students" asp-action="Index" role="search">
                    <i class="bi bi-search"></i>
                    <input type="search" name="q" class="form-control" placeholder="O'quvchini qidirish: ism, telefon, pasport..." autocomplete="off" />
                </form>
                <div class="ms-auto d-flex align-items-center gap-2">
                    <a class="btn btn-primary d-none d-md-inline-flex" asp-controller="Students" asp-action="Create"><i class="bi bi-person-plus"></i> Yangi o'quvchi</a>
                    <button class="icon-btn" type="button" id="themeToggle" title="Yorug' / qorong'i rejim"><i class="bi bi-moon-stars"></i></button>
                    <div class="dropdown">
                        <button class="icon-btn" data-bs-toggle="dropdown" aria-label="Profil"><i class="bi bi-person-circle"></i></button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li class="px-3 py-2">
                                <div class="fw-semibold">@Me.FullName</div>
                                <div class="small text-muted">@Me.UserName · @roleText</div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key"></i> Parolni o'zgartirish</a></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Chiqish</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="content">
                @RenderBody()
            </main>
        </div>
    </div>

    <div class="toast-stack" id="toastStack">
        @if (TempData["Ok"] is string ok)
        {
            <div class="pm-toast" data-autohide="6000">
                <span class="ic tone-success"><i class="bi bi-check2-circle"></i></span>
                <div class="msg">
                    @ok
                    @if (TempData["ReceiptId"] is int receiptId)
                    {
                        <div class="mt-2">
                            <a class="btn btn-sm btn-light" asp-controller="Payments" asp-action="Receipt" asp-route-id="@receiptId" target="_blank"><i class="bi bi-printer"></i> Kvitansiyani chop etish</a>
                        </div>
                    }
                </div>
                <button class="close" type="button" data-dismiss-toast><i class="bi bi-x-lg"></i></button>
            </div>
        }
        @if (TempData["Err"] is string err)
        {
            <div class="pm-toast" data-autohide="9000">
                <span class="ic tone-danger"><i class="bi bi-exclamation-triangle"></i></span>
                <div class="msg">@err</div>
                <button class="close" type="button" data-dismiss-toast><i class="bi bi-x-lg"></i></button>
            </div>
        }
    </div>

    <div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body p-4 text-center">
                    <div class="empty-icon tone-danger mb-3"><i class="bi bi-exclamation-triangle"></i></div>
                    <h5 class="fw-semibold mb-2">Tasdiqlang</h5>
                    <p class="text-muted mb-4" id="confirmText"></p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Bekor qilish</button>
                        <button type="button" class="btn btn-danger" id="confirmOk">Ha, davom etish</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
